# AI Provider 선택: anthropic (기본값) | gemini
AI_PROVIDER=anthropic

# Anthropic 사용 시
ANTHROPIC_API_KEY=

# Gemini 사용 시 (AI_PROVIDER=gemini)
GEMINI_API_KEY=

# 로컬 LLM(Ollama)으로 이력서 필드 추출(extractResumeFields)만 우회 — AI_PROVIDER 값은 그대로 유지됨
# 사전 준비: `brew install --cask ollama` (Intel Mac은 formula 빌드가 git 메타데이터 이슈로 실패할 수 있어 cask 권장)
#           `ollama serve` 후 `ollama pull qwen3.5:4b`
# 참고: Intel Mac은 Apple Silicon 대비 5~10배 느림 (실측 34~45초/건, Gemini는 3초 내외)
LOCAL_EXTRACTION_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3.5:4b

# NextAuth
NEXTAUTH_SECRET=                          # openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.amplifyapp.com

# Kakao OAuth (developers.kakao.com에서 발급)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Supabase (supabase.com에서 발급)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
